# Copy to .env and fill in real values. Never commit the real .env file.

# LLM (optional; falls back to deterministic template reports if unset)
GEMINI_API_KEY=

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ADMIN_USERNAME=admin
# Generate a hash with: python -c "from api.auth import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD_HASH=

# Persistence (strongly recommended in production)
# Postgres connection string. When set, user accounts, invites and synced
# watchlist/trades/alerts are stored here instead of flat JSON files under
# storage/, which PaaS free tiers (e.g. Render) wipe on every redeploy.
DATABASE_URL=

# Public site / CORS
# Comma-separated browser origins allowed to call the API. Leave empty for
# local development (any localhost port is allowed); REQUIRED in production.
ALLOWED_ORIGINS=
# Canonical public frontend URL, no trailing slash.
SITE_URL=https://stock-market-analyser-vert.vercel.app

# Frontend (set these in Vercel, not here - VITE_* values are public and
# are compiled into the JavaScript every visitor downloads)
# VITE_API_URL=https://stonks-backend-t9jb.onrender.com
# VITE_SITE_URL=https://stock-market-analyser-vert.vercel.app
# VITE_UMAMI_WEBSITE_ID=   # optional; analytics stays off until set
# VITE_UMAMI_SRC=          # optional; defaults to Umami Cloud
