{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--reload",
        "--port",
        "8002"
      ],
      "port": 8002
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5190"
      ],
      "port": 5190
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "preview",
        "--",
        "--port",
        "5199"
      ],
      "port": 5199
    },
    {
      "name": "backend-localdb",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": [
        "-c",
        "import os; os.environ['DATABASE_URL']=''; import uvicorn; uvicorn.run('main:app', host='127.0.0.1', port=8002)"
      ],
      "port": 8002
    }
  ]
}